# Required
ADMIN_PASSWORD=change-me
SESSION_SECRET=            # openssl rand -hex 32

# Recommended
PUBLIC_URL=https://deployguard.home.prateeksavanur.dev   # used for links in alerts
# SECURE_COOKIES=true                          # set when served over HTTPS

# Optional
# INTEGRATION_API_KEY=         # workspace key for Argo CD Notifications etc.: echo dg_$(openssl rand -hex 24)
# BOOTSTRAP_PATH=              # JSON file declaring projects, health URLs and alert channels
# GITHUB_TOKEN=                # fetch commit lists for private GitHub repos (read-only "contents" scope)
# HEALTH_INTERVAL_SECONDS=60
# HEALTH_TIMEOUT_MS=5000
# HEALTH_FAILURE_THRESHOLD=3   # consecutive failures before "down" / "unhealthy"
# VERIFY_WINDOW_SECONDS=300    # how long to watch an environment after a deploy
# VERIFY_INTERVAL_SECONDS=15
# HEALTH_RETENTION_DAYS=14
# LOG_LEVEL=info
